{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/home.html",
      "permanent": false
    },
    {
      "source": "/register-login",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/our-partners",
      "destination": "/partners",
      "permanent": true
    },
    {
      "source": "/checkin",
      "destination": "/app/checkin",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}